# 浏览器登录 notion.so → DevTools → Application → Cookies → https://www.notion.so
NOTION_TOKEN_V2=
# 同一位置的 notion_user_id cookie（浏览器里登录了多个账号时必填）
NOTION_USER_ID=
# 下载附件需要：file.notion.so 域名下的 file_token cookie
# （DevTools → Application → Cookies → https://file.notion.so，没有的话先在 Notion 里打开一张图片）
NOTION_FILE_TOKEN=
NOTION_DB_PATH=notion_backup.db
